# LINE Messaging API
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# Discord Bot
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_discord_server_id_here
DISCORD_LINE_CATEGORY_ID=your_discord_category_id_here

# Neon (Postgres)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional: Discord webhook for groups not yet in the DB
LINE_FALLBACK_WEBHOOK_URL=

# Optional: guards the ?seed migration endpoint (GET /api/webhooks/line?seed=...)
LINE_ADMIN_TOKEN=
